{
  "_about": "Customer types exported from the live reference implementation's customer_categories table (dynamic_form_schema, omitted_standard_fields and flags are exact). 'standardFieldBlocks' and 'compositionRules' are transcribed from the reference frontend code. 'resolvedStep2Fields' is DERIVED by applying compositionRules to each type (assuming no requirement profile adds employment/business blocks) and is what the Step 2 card actually shows, before the separate Account Number section.",
  "fieldDefinitionSchema": {
    "key": "string, unique within the type; the answer key in dynamicFormData",
    "label": "string, exact label shown to the officer",
    "type": [
      "text",
      "textarea",
      "number",
      "currency",
      "date",
      "select",
      "boolean"
    ],
    "required": "boolean",
    "options": "array of strings — fixed options for a select; the chosen string is stored",
    "dataSource": "master-data list slug for a select; the chosen row ID is stored",
    "dependsOn": "key of the parent field (cascading select); options filtered by parent id; changing parent clears this field",
    "requiredWhen": "{ field: <key>, equals: [values or master-data codes] } — conditionally required",
    "storesIn": "allowlisted customer column (camelCase payload name) — answer stored in that column instead of dynamicFormData",
    "fullWidth": "display hint (reference renderer only spans textarea across both columns)",
    "placeholder": "optional string",
    "helpText": "optional string"
  },
  "masterDataSources": {
    "government-bodies": {
      "parent": null
    },
    "government-departments": {
