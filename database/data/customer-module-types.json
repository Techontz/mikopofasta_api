          "type": "select",
          "required": false,
          "storesIn": "employerId",
          "dataSource": "employers"
        }
      ],
      "whenRequiresContract": [
        {
          "key": "contract_type_id",
          "label": "Contract Type",
          "type": "select",
          "required": false,
          "storesIn": "contractTypeId",
