      },
      {
        "key": "business_address",
        "label": "Business Address",
        "type": "text",
        "required": false,
        "storesIn": "businessAddress",
        "fullWidth": true
      },
      {
        "key": "tin_number",
        "label": "TIN Number (Optional)",
        "type": "text",
