###############################################################################
# Mikopofasta API — environment template
# Copy to .env and fill in real values:  cp .env.example .env && php artisan key:generate
###############################################################################

APP_NAME=Mikopofasta
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Dar_es_Salaam
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# --- Logging ----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_OPERATIONS_LEVEL=info
LOG_OPERATIONS_DAYS=90

# --- Database (MySQL 8+) ----------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mikopofasta
DB_USERNAME=root
DB_PASSWORD=

# Separate schema used by the Pest suite (see phpunit.xml).
DB_TEST_DATABASE=mikopofasta_test

# --- Cache / Session / Queue (Redis) ----------------------------------------
# predis is used because the phpredis C extension is not assumed to be present.
# Switch to REDIS_CLIENT=phpredis in production for throughput.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=mikopofasta_

CACHE_STORE=redis
CACHE_PREFIX=

QUEUE_CONNECTION=redis
REDIS_QUEUE=default
# Named queues used by the platform (backend spec §1):
#   ledger        — ledger-affecting side effects
#   notifications — SMS / mail fan-out
#   reports       — report + risk-score recomputation
QUEUE_LEDGER=ledger
QUEUE_NOTIFICATIONS=notifications
QUEUE_REPORTS=reports

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# --- Filesystem -------------------------------------------------------------
# KYC documents, liveness captures, deposit slips and payslips go to the
# private `kyc` disk and are only ever served via temporary signed URLs.
FILESYSTEM_DISK=local

# --- Mail -------------------------------------------------------------------
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@mikopofasta.co.tz"
MAIL_FROM_NAME="${APP_NAME}"

# --- API / CORS -------------------------------------------------------------
# Comma-separated origins allowed to call the API from a browser.
# The Next.js frontend calls the API server-to-server (no CORS), but any
# browser-side call must be listed here explicitly — never use "*".
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Sanctum ----------------------------------------------------------------
# Token-based auth (not SPA cookie mode) — see backend spec §1.
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
SANCTUM_TOKEN_EXPIRATION=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Provider webhook signing secrets (spec §1). An empty secret REJECTS that
# provider's callbacks — it never disables verification.
WEBHOOK_PAYMENTS_HEADER=X-Bank-Signature
WEBHOOK_PAYMENTS_SECRET=
WEBHOOK_VODACOM_HEADER=X-Vodacom-Signature
WEBHOOK_VODACOM_SECRET=
WEBHOOK_TIMESTAMP_HEADER=X-Webhook-Timestamp
WEBHOOK_TOLERANCE_SECONDS=300
